# =============================================================================
# VeriTrace - Environment Configuration EXAMPLE
# =============================================================================
# Copy this file to ".env" and fill in your actual secret values.
# NEVER commit ".env" to Git - only commit ".env.example".
#
#   cp .env.example .env
#
# To generate a strong VERITRACE_MASTER_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ─── Server Master Key (Key Encryption Key - KEK) ───────────────────────────
VERITRACE_MASTER_KEY=your_generated_secret_key_here

# ─── Flask Settings ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=your_flask_secret_key_here

# ─── TSA (RFC 3161 Timestamping) ────────────────────────────────────────────
# Optional: Override default TSA URL. Leave commented to use built-in default.
# TSA_URL=http://timestamp.digicert.com

# ─── Upload Directory ────────────────────────────────────────────────────────
# Optional: Override default upload directory path.
# UPLOAD_DIR=/path/to/uploads
